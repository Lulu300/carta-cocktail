generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless imports, as tsc compiles them for CommonJS. Without this, the
  // client generated without tsconfig.json (npm ci in the Docker image) would
  // import "./internal/class.ts", which the compiled code cannot load.
  importFileExtension = ""
}

// The database URL is read from prisma.config.ts (CLI) and src/lib/prisma.ts (application)
datasource db {
  provider = "sqlite"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  // Copied into each token; incrementing it revokes every token issued before
  tokenVersion Int      @default(0)

  apiTokens ApiToken[]
}

// Token of a script or an MCP client (F-16), sent as `Authorization: Bearer carta_...`.
// Only the SHA-256 hash of the secret is stored: the token itself is shown once, when it
// is created. Revoking a token deletes its row. Never exported in a backup.
model ApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  // Last characters of the token, so that the admin can tell tokens apart in the list
  lastFour   String
  scope      String    // READ_ONLY, READ_WRITE
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  // Updated at most once a minute per token, not at every request
  lastUsedAt DateTime?

  @@index([userId])
}

model CategoryType {
  name             String  @id
  nameTranslations String?
  color            String  @default("gray")

  categories Category[]
}

model Category {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  nameTranslations String?  // JSON: {"fr": "...", "en": "..."}
  type             String   // CategoryType.name: SPIRIT, SYRUP, SOFT or a custom type
  categoryType     CategoryType @relation(fields: [type], references: [name], onDelete: Restrict, onUpdate: Cascade)
  desiredStock     Int      @default(1)
  minimumPercent   Int      @default(30)
  createdAt        DateTime @default(now())

  bottles             Bottle[]
  cocktailIngredients CocktailIngredient[]

  @@index([type])
}

model Bottle {
  id               Int       @id @default(autoincrement())
  name             String
  categoryId       Int
  category         Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  purchasePrice    Float?
  capacityMl       Int
  remainingPercent Int       @default(100)
  openedAt         DateTime?
  alcoholPercentage Float?   // Optional alcohol percentage
  location         String?   // Optional free-text storage location
  isApero          Boolean   @default(false) // Usable as apéritif
  isDigestif       Boolean   @default(false) // Usable as digestif
  createdAt        DateTime  @default(now())

  cocktailIngredients CocktailIngredient[]
  preferredFor        CocktailPreferredBottle[]
  menuBottles         MenuBottle[]
  menuExclusions      MenuBottleExclusion[]

  @@index([categoryId])
}

model Ingredient {
  id               Int      @id @default(autoincrement())
  name             String   @unique
  nameTranslations String?  // JSON: {"fr": "...", "en": "..."}
  icon             String?
  isAvailable      Boolean  @default(true)
  createdAt        DateTime @default(now())

  cocktailIngredients CocktailIngredient[]
}

model Unit {
  id                   Int     @id @default(autoincrement())
  name                 String
  nameTranslations     String? // JSON: {"fr": "...", "en": "..."}
  abbreviation         String  @unique
  conversionFactorToMl Float?  // Factor to convert this unit to ml (null = non-convertible)

  cocktailIngredients CocktailIngredient[]
}

model Cocktail {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  notes       String?
  imagePath   String?
  tags        String   @default("")
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients  CocktailIngredient[]
  instructions CocktailInstruction[]
  menuCocktails MenuCocktail[]
}

model CocktailIngredient {
  id         Int      @id @default(autoincrement())
  cocktailId Int
  cocktail   Cocktail @relation(fields: [cocktailId], references: [id], onDelete: Cascade)
  quantity   Float
  unitId     Int
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sourceType String   // BOTTLE, CATEGORY, INGREDIENT
  bottleId   Int?
  bottle     Bottle?  @relation(fields: [bottleId], references: [id], onDelete: Restrict)
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  ingredientId Int?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  position   Int      @default(0)

  preferredBottles CocktailPreferredBottle[]

  @@index([cocktailId])
  @@index([bottleId])
  @@index([categoryId])
  @@index([ingredientId])
  @@index([unitId])
}

model CocktailPreferredBottle {
  id                   Int                @id @default(autoincrement())
  cocktailIngredientId Int
  cocktailIngredient   CocktailIngredient @relation(fields: [cocktailIngredientId], references: [id], onDelete: Cascade)
  bottleId             Int
  bottle               Bottle             @relation(fields: [bottleId], references: [id], onDelete: Cascade)

  @@unique([cocktailIngredientId, bottleId])
  @@index([bottleId])
}

model CocktailInstruction {
  id         Int      @id @default(autoincrement())
  cocktailId Int
  cocktail   Cocktail @relation(fields: [cocktailId], references: [id], onDelete: Cascade)
  stepNumber Int
  text       String

  @@index([cocktailId])
}

model Menu {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  slug        String   @unique
  type        String   @default("COCKTAILS") // COCKTAILS, APEROS, DIGESTIFS
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cocktails MenuCocktail[]
  bottles   MenuBottle[]
  sections  MenuSection[]

  bottleExclusions MenuBottleExclusion[]
}

model MenuCocktail {
  id            Int          @id @default(autoincrement())
  menuId        Int
  menu          Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  cocktailId    Int
  cocktail      Cocktail     @relation(fields: [cocktailId], references: [id], onDelete: Cascade)
  menuSectionId Int?
  menuSection   MenuSection? @relation(fields: [menuSectionId], references: [id], onDelete: SetNull)
  position      Int          @default(0)
  isHidden      Boolean      @default(false)

  @@unique([menuId, cocktailId])
  @@index([cocktailId])
  @@index([menuSectionId])
}

model MenuBottle {
  id            Int          @id @default(autoincrement())
  menuId        Int
  menu          Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  bottleId      Int
  bottle        Bottle       @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  menuSectionId Int?
  menuSection   MenuSection? @relation(fields: [menuSectionId], references: [id], onDelete: SetNull)
  position      Int          @default(0)
  isHidden      Boolean      @default(false)

  @@unique([menuId, bottleId])
  @@index([bottleId])
  @@index([menuSectionId])
}

// Bottle the admin removed from a system menu: the sync never adds it back.
// A table rather than a MenuBottle flag, so MenuBottle only holds the bottles shown.
model MenuBottleExclusion {
  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  bottleId  Int
  bottle    Bottle   @relation(fields: [bottleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([menuId, bottleId])
  @@index([bottleId])
}

model MenuSection {
  id        Int      @id @default(autoincrement())
  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)

  cocktails MenuCocktail[]
  bottles   MenuBottle[]

  @@index([menuId])
}

model SiteSettings {
  id       Int    @id @default(1)
  siteName String @default("Carta Cocktail")
  siteIcon String @default("")
  // Sites allowed to show the public menu in an iframe: origins separated by one space, the
  // format of a CSP source list (services/embedOrigins.ts). Empty: no site.
  embedOrigins String @default("")
  // Code Mode of the MCP server (F-15): the `search` and `execute` tools, which run code written
  // by an AI agent in a sandbox on the server. Off until the admin turns it on in Settings.
  codeModeEnabled Boolean @default(false)
}

// State of the instance itself, not of its content: a single row (id = 1). A
// backup restore keeps the live row (backupService.ts).
model AppState {
  id                   Int       @id @default(1)
  // APP_VERSION of the last start ("X.Y.Z" or "X.Y.Z-rc.N"), null until a released version has run
  lastRunVersion       String?
  // Upgrade whose required actions the admin has not confirmed yet (in-app upgrade guide)
  pendingNoticeFrom    String?
  pendingNoticeTo      String?
  noticeAcknowledgedAt DateTime?
}
