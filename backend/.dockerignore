# Keep the build context to what the image needs: no local secrets,
# no host dependencies (built for another OS), no local data or test files.
# Patterns match from the context root only: "**/" also covers subfolders
# (local SQLite files live in prisma/).
node_modules
# The image generates its own Prisma client
src/generated
dist
coverage
**/.env*
**/*.db
**/*.db-journal
prisma/prisma
# Leftovers of interrupted runs, never needed by the image: the test database
# folder, SQLite WAL side files, a half-done restore copy and the session floor
# file (the container creates its own at runtime)
prisma/test
**/*.db-wal
**/*.db-shm
**/*.db.restore-*
**/*.session-floor*
.omc
**/.claude
**/.DS_Store
**/*.test.ts
src/test
vitest.config.ts
