node_modules
# Keep environment variables out of version control
.env

# Prisma client, generated by `npx prisma generate`
/src/generated/

# Test database folder (src/test/testDatabase.ts): leftovers of an interrupted run
/prisma/test/

# Copy of the database a restore writes before swapping it in: left behind by an
# interrupted restore (the root .gitignore holds the other *.db* patterns)
*.db.restore-*
