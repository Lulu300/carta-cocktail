# Backend
DATABASE_URL="file:./carta_cocktail.db"
# SQLite uses WAL by default. Set to false to keep the rollback journal: required
# when the database is on a network share (SMB/NFS). Docker reads it from the
# compose file only (see README, "Database files and network shares").
# SQLITE_WAL=false
# Required. Random value of at least 32 characters: openssl rand -hex 32
JWT_SECRET=
ADMIN_EMAIL="admin@carta.local"
# Required to create the admin on first start: at least 12 characters.
# Ignored once the admin exists (change it from Settings > Profile).
ADMIN_PASSWORD=
# Set to true for one restart to reset the admin email and password from the
# two variables above, then remove it.
# ADMIN_RESET_PASSWORD=true
PORT=3001
# Optional, the defaults suit a standard install. Docker reads them from the
# compose file only (see README, "Environment Variables").
# Admin session lifetime: a number of seconds, or a timespan such as 24h or 7d.
# JWT_EXPIRES_IN=7d
# Failed logins allowed per client IP address in 15 minutes (then 429).
# LOGIN_RATE_LIMIT=10
# Proxies trusted for X-Forwarded-For: a number of proxies, or a list of
# addresses, subnets or names. The default trusts the host and private networks
# (nginx, SWAG...). See README, "Login limit behind a reverse proxy".
# TRUST_PROXY="loopback, linklocal, uniquelocal"
# Origin allowed to call the API from another site. Empty (default): none.
# CORS_ORIGIN=https://example.com

# Frontend
VITE_API_URL=http://localhost:3001/api
