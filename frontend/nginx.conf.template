# Link preview robots of messaging apps and social networks, matched on the User-Agent without
# case. They read the Open Graph tags of a shared link but do not run JavaScript, so the SPA
# shell tells them nothing. iMessage sends facebookexternalhit and Twitterbot. Keep the list
# short: a robot missing here only shows a plain link.
map $http_user_agent $is_preview_bot {
    default 0;
    "~*(facebookexternalhit|facebot|whatsapp|twitterbot|slackbot|telegrambot|discordbot|linkedinbot|skypeuripreview)" 1;
}

server {
    # Unprivileged port: nginx runs as a non-root user (also under rootless Docker and Podman).
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    # The host publishes this port under another number ("80:8080"): a redirect such as
    # /assets -> /assets/ must stay relative instead of naming port 8080.
    absolute_redirect off;

    include /etc/nginx/snippets/security-headers.conf;

    # nginx defaults to 1 MB. It counts the whole multipart body, so it must stay above each
    # backend upload limit plus the multipart envelope: MAX_IMAGE_BYTES (5 MiB) and
    # MAX_BOTTLE_IMPORT_BYTES (10 MiB), see "File Uploads" in backend/AGENTS.md
    # (backend/src/uploadLimits.test.ts checks it).
    # The backup restore has its own location.
    client_max_body_size 20m;

    # The nginx base image ships with gzip disabled. Proxied API responses are compressed too.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/csv text/javascript application/javascript application/json image/svg+xml;

    # Declared once here: proxy_set_header is inherited by every proxied location
    # as long as that location does not define its own.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Host as the client sent it, port included ($host drops it): the link previews of
    # /menu/ build absolute URLs from it when PUBLIC_BASE_URL is not set.
    proxy_set_header X-Forwarded-Host $http_host;

    # Resolve the backend at request time, not once at startup: a recreated backend container
    # gets a new IP, which would otherwise give 502 errors until nginx restarts. The resolvers
    # are read from /etc/resolv.conf by the image entrypoint (NGINX_ENTRYPOINT_LOCAL_RESOLVERS).
    # With a variable, proxy_pass must not carry a URI: nginx then forwards the request URI as is.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;
    set $backend http://${BACKEND_HOST}:3001;

    # Backup restore: large archive, streamed to the backend instead of buffered on disk.
    # Keep the size in line with MAX_BACKUP_UPLOAD_BYTES in backend/src/services/backupService.ts
    # (200 MiB), plus a margin for the multipart envelope: an archive of exactly that size reaches
    # the backend, and the backend answers the 413 for a larger one (checked by
    # backend/src/uploadLimits.test.ts).
    # These timeouts, and client_body_timeout (nginx's default of 60 s between two reads of the
    # body), bound the gap between two reads or writes, not the whole upload: the backend sets
    # no total limit either (backend/src/serverTimeouts.ts), so a slow upload may last over 300 s.
    location = /api/backup/import {
        client_max_body_size 210m;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass $backend;
    }

    # API proxy
    location /api/ {
        proxy_pass $backend;
    }

    # Uploaded photos: file names are unique per upload, so a long cache is safe.
    # Express sends its own Cache-Control (max-age=0); hide it to avoid two headers.
    location ^~ /uploads/ {
        proxy_pass $backend;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=2592000";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Vite build output: file names contain a content hash, so they never change.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The SPA shell must be revalidated on every load, otherwise a browser can keep
    # an old index.html that references assets removed by a new deployment.
    # SPA routes reach this location through the try_files fallback below.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Service worker (vite-plugin-pwa): revalidated on every load, like index.html, so that a
    # browser or a proxy never holds on to an old worker and the old app it precached.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Web app manifest: the mime.types of nginx does not know the .webmanifest extension.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Docker healthcheck of the frontend service: kept out of the access log, so that the probe
    # (every 30 s) does not bury the requests of real visitors.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Public menu and cocktail pages. Preview robots get a small HTML page with the Open Graph
    # tags of the menu or the cocktail, built by the backend (/api/public/share/menu/...); every
    # other client gets the SPA, as on any other route. "rewrite ... last" is one of the uses of
    # "if" in a location that nginx documents as safe.
    location /menu/ {
        if ($is_preview_bot) {
            rewrite ^ /api/public/share$uri last;
        }
        try_files $uri $uri/ /index.html;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
